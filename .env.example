NEXT_PUBLIC_SITE_URL=https://mirflow.online

# --- Booking -----------------------------------------------------------------
# Public Calendly scheduling link, e.g. https://calendly.com/<user>/<event>.
# No working link survives in Git history, so this starts unset: every
# "Book a call" button falls back to the inquiry form, phone, and email.
# Must be https. Calendly links are also embedded inline on /pricing.
NEXT_PUBLIC_CALENDLY_URL=

# --- Lead + order notifications ----------------------------------------------
# Use a verified sender domain in Resend. Keep these server-only.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=bobby@mirflow.online
# Without RESEND_API_KEY + CONTACT_TO_EMAIL the forms and the Stripe webhook are
# log-only (the visitor still gets a success response).

# --- Stripe ------------------------------------------------------------------
# Server-only. sk_test_... keeps /pricing in test mode and shows a test banner.
STRIPE_SECRET_KEY=
# Signing secret for /api/stripe-webhook. Unset => the webhook returns 503.
STRIPE_WEBHOOK_SECRET=

# Approved-price allowlist. A package can only be bought online when BOTH of its
# Price IDs are set here AND the live Stripe amounts match the figures published
# on /pricing. Leave a pair unset and that package's button books a call instead.
#   front-desk   $2,000 setup + $500/mo   (approved, live on /ai-receptionist)
STRIPE_FRONT_DESK_SETUP_PRICE_ID=
STRIPE_FRONT_DESK_MONTHLY_PRICE_ID=
#   presence     DRAFT amounts - do not create these Prices until approved
STRIPE_PRESENCE_SETUP_PRICE_ID=
STRIPE_PRESENCE_MONTHLY_PRICE_ID=
#   growth       DRAFT amounts - do not create these Prices until approved
STRIPE_GROWTH_SETUP_PRICE_ID=
STRIPE_GROWTH_MONTHLY_PRICE_ID=
#   full-service DRAFT amounts - do not create these Prices until approved
STRIPE_FULL_SERVICE_SETUP_PRICE_ID=
STRIPE_FULL_SERVICE_MONTHLY_PRICE_ID=
