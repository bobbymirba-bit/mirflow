NEXT_PUBLIC_SITE_URL=https://mirflow.online

# --- Booking -----------------------------------------------------------------
# Public Calendly scheduling link, e.g. https://calendly.com/<user>/<event>.
# OPTIONAL. Unset, every "Book a call" button uses the checked default in
# src/lib/booking.ts (https://calendly.com/bobbymirba/30min). Set this to point
# bookings at a different event without a deploy. Must be https; a value that
# isn't a clean https URL is ignored in favour of the default. Calendly links
# are also embedded inline on /pricing.
NEXT_PUBLIC_CALENDLY_URL=

# --- Lead + order notifications ----------------------------------------------
# Use a verified sender domain in Resend. Keep these server-only.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=bobby@mirflow.online
# Without RESEND_API_KEY + CONTACT_TO_EMAIL the forms and the Stripe webhook are
# log-only (the visitor still gets a success response). With them set, a failed
# order notification makes the webhook answer 500 so Stripe retries.

# --- Stripe ------------------------------------------------------------------
# Server-only.
#
# PREVIEW AND DEVELOPMENT MUST USE sk_test_ KEYS. Never put a live sk_ key on a
# preview deployment. A test key shows the "Stripe test mode" banner on
# /pricing; a live key on a non-production deployment makes /api/checkout
# refuse outright.
STRIPE_SECRET_KEY=
# Signing secret for /api/stripe-webhook. Unset => the webhook returns 503.
STRIPE_WEBHOOK_SECRET=

# Price IDs per package. These are NOT the gate on their own.
#
# A package can only be bought online when ALL of the following hold:
#   1. its id is listed in APPROVED_PACKAGES in src/lib/checkout-config.ts
#      (that constant is EMPTY, so nothing is purchasable today);
#   2. it has a published list price in src/data/pricing.ts;
#   3. both of its Price IDs below are set;
#   4. the live Stripe amounts match the published figures exactly.
#
# Setting the variables below does nothing while APPROVED_PACKAGES is empty.
# Do not create Stripe Prices for the current list price until Bobby says so.
#   all-in-one   list price $2,997 setup + $1,497/mo — no Stripe Prices exist
STRIPE_ALL_IN_ONE_SETUP_PRICE_ID=
STRIPE_ALL_IN_ONE_MONTHLY_PRICE_ID=
