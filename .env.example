NEXT_PUBLIC_SITE_URL=https://mirflow.online

# Public https booking link. Leave empty to hide "Book a 15-minute call".
NEXT_PUBLIC_BOOKING_URL=

# Resend. Keep the API key server-only.
# CONTACT_FROM_EMAIL should be the verified sender: Mirflow <leads@mirflow.online>
# The lead route always delivers to bobby@mirflow.online.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Mirflow <leads@mirflow.online>
CONTACT_TO_EMAIL=bobby@mirflow.online

# Stripe checkout is retired; /api/checkout stays inert (404) unless this is "true".
# CHECKOUT_ENABLED=
